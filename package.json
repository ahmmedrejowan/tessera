{
  "name": "tessera",
  "productName": "Tessera",
  "version": "0.1.0",
  "description": "A desktop library for game assets: every pack in one place, with its licence and source on record.",
  "author": "K M Rejowan Ahmmed <kmrejowan@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "electron scripts/make-icon.cjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/three": "^0.186.0",
    "@types/utif": "^3.0.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "ag-psd": "^31.0.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "utif": "^3.1.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "yazl": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "homepage": "https://github.com/ahmmedrejowan/tessera",
  "build": {
    "appId": "com.ahmmedrejowan.tessera",
    "productName": "Tessera",
    "copyright": "Copyright © 2026 K M Rejowan Ahmmed",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en"
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Tessera reads and keeps your asset library, and its backups, where you choose, which can be in Documents.",
        "NSDesktopFolderUsageDescription": "Tessera reads and keeps your asset library, and its backups, where you choose, which can be on the Desktop.",
        "NSDownloadsFolderUsageDescription": "Tessera adds asset packs you downloaded, from the Downloads folder.",
        "NSRemovableVolumesUsageDescription": "Tessera can keep your library or its backups on an external drive.",
        "NSNetworkVolumesUsageDescription": "Tessera can keep your library or its backups on a network drive."
      }
    },
    "dmg": {
      "title": "Tessera ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "K M Rejowan Ahmmed <kmrejowan@gmail.com>"
    },
    "npmRebuild": false
  }
}
